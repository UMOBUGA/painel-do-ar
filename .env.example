# Sem DATABASE_URL, a API roda contra um Postgres embutido (PGlite) num
# arquivo local — zero configuração para desenvolver. Defina isto só em
# produção, apontando para um Postgres real (Neon, Supabase, Vercel Postgres
# etc.).
# DATABASE_URL=postgres://user:password@host:5432/painel_do_ar

# Protege /api/cron/snapshot de ser chamado por qualquer um. Necessário em
# produção; em dev o endpoint fica aberto se isto não estiver definido.
# CRON_SECRET=defina-um-valor-aleatorio-aqui
